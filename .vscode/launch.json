{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Centrala (8080)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/centrala",
      "python": "${workspaceFolder}/centrala/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8080"]
    },
    {
      "name": "Terminal (8081)",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/terminal",
      "python": "${workspaceFolder}/terminal/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": ["main:app", "--host", "0.0.0.0", "--port", "8081"]
    }
  ],
  "compounds": [
    {
      "name": "Start Both (Centrala + Terminal)",
      "configurations": ["Centrala (8080)", "Terminal (8081)"]
    }
  ]
}
