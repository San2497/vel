# Zkopírujte do .env a upravte.
# Adresa centrály (ve škole porty 8080–8090 nebo 65525–65535, síť 10.2.0.0/16).
# Na Windows použijte 127.0.0.1 místo localhost (localhost zkouší nejdřív IPv6 a ztratí ~2 s).
CENTRAL_URL=http://127.0.0.1:8080
# Patro, které tento terminál zobrazuje.
FLOOR=2
# Veřejná adresa tohoto terminálu, jak ji uvidí centrála (port musí sedět s --port).
MY_URL=http://127.0.0.1:8081
# Kolik id zpracovaných událostí si pamatovat (ochrana proti duplicitám).
MAX_SEEN_EVENTS=10000
# DEBUG=1 zapne /debug/slow (simulace výpadku). Na veletrhu nechte 0.
DEBUG=0
